// BangModVanilla - Vars.uci
// Included via BangModVanillaPlayerController.uci. Vars live in PC/Vars.uci; DefaultProperties in PC/Effects.uci (last).
var BangModVanillaCustomizationContent CustomizationBaseDummy;
var float InterpYaw;
var float InterpPitch;

var bool bShowDeathMessages;
var bool bPCShowHitTime;
var bool bShowHitTime;

var bool bShowGroundSpeed;

var float fLastFeintTime;  // Track when last feint was attempted to prevent spam

var bool bShownOptimizationTip;  // Track if we've shown the optimization tip to this player

// Camera shake configuration
var globalconfig bool bDisableScreenShake;  // Disable all camera shake effects (flinch, dazed, hits)

// Legacy parry-component visualization/sizing config; melee parry success is now directional in Pawn/Combat.uci.
var globalconfig bool bBangModVanillaParryBox;
var globalconfig bool bSkeletalParry;
var globalconfig bool bBangModVanillaGoFast;  // When true, shortens sprint ramp-up per class (top speed unchanged)

// Collision bubble radius (OuterCylinder)
var globalconfig float fBangModVanillaCollisionRadius;  // Radius of the player collision bubble; vanilla AOC default is 39.0

// BangModVanilla: Persisted client-clock offset (server-only) for the hit-trade timestamp system.
// The offset is accumulated on the pawn (BangModVanillaPawn.fClientClockOffset); we stash it here when
// the pawn dies and re-seed the next pawn on Possess, so the system isn't cold (falling back to
// pure ping reconstruction) for the first hit or two after every respawn.
var float fPersistedClientClockOffset;
var bool  bPersistedClockOffsetInit;

// BangModVanilla: First-person spectator (see the FIRST-PERSON SPECTATOR block further down).
var bool    bBangModVanillaFPSpectate;      // desired perspective while following a player (true = first person)
var AOCPawn BangModVanillaFPObservedPawn;   // pawn we currently have first-person-observer state applied to
var AOCPawn BangModVanillaHUDPawn;          // pawn the spectator health/stamina HUD is currently showing
var AOCPawn BangModVanillaPerspectivePawn;  // pawn we have already established a camera perspective for
var float   fBangModVanillaNextFPRetry;     // WorldInfo.TimeSeconds gate for re-poking a pawn to rebuild its 1P mesh
var AOCPawn BangModVanillaFPBlockLoggedPawn; // pawn whose first-person refusal we have already logged

// BangModVanilla: health/stamina bar enforcement (see BangModVanillaEnforceLifeBars)
var AOCPawn BangModVanillaLifeBarPawn;          // pawn the bars are currently showing
var float   fBangModVanillaNextLifeBarAssert;   // throttle for re-asserting bar visibility
var int     iBangModVanillaLastHealthShown;
var float   fBangModVanillaLastStaminaShown;

// BangModVanilla: spectator field-of-view lock (see BangModVanillaEnforceSpectateFOV)
var float   fBangModVanillaFOVCaught;       // last wrong FOV value we corrected while spectating
var name    nBangModVanillaFOVCaughtWhere;  // which hook caught it -- reported by FPSpectateDebug

// BangModVanilla: minimum client send rate (see BangModVanillaRestoreNetSpeed).
//   0 (or absent from the ini) = use the built-in default of 15000
//   negative                   = opt out entirely
// Deliberately NOT relying on globalconfig to deliver the default: measured on a
// live client this read back 0 even with iBangModVanillaMinNetSpeed=15000 in
// defaultproperties, the key absent from every ini, and no competing
// defaultproperties block in the including class. So 0 is treated as unset.
var globalconfig int iBangModVanillaMinNetSpeed;
var int iBangModVanillaMinNetSpeedFallback;  // plain var: config cannot zero this one
var float fBangModVanillaNextNetSpeedCheck;  // throttle for the tick-side assert
var name  nBangModVanillaNetSpeedBlock;      // why the last automatic attempt did nothing
var int   iBangModVanillaNetSpeedTries;      // how many times it has tried

// BangModVanilla: spectator team lock (see BangModVanillaMayView)
var int     iBangModVanillaViewBlocks;      // times we refused an out-of-team view target
var name    nBangModVanillaViewBlockWhere;  // which hook refused it, for FPSpectateDebug

// BangModVanilla: admin-only pause control (ported from NateMod). Pausing is restricted
// to admins; unpausing is also admin-only and runs a short 3-2-1-GO countdown so
// players get a heads-up before the action resumes.
var bool  bIsPaused;              // true while an admin has the game paused
var int   UnpauseCountdownTime;   // countdown start value (default 3)

// BangModVanilla: inebriate on any map (see the block above ClientInebriate for the why).
// Declared up here because UnrealScript requires every var before the first function
// in the class body -- and this .uci is pasted straight into one.
var PostProcessChain BangModVanillaDrunkChain;   // ChivPostProcess_drunk, from defaultproperties
var bool bBangModVanillaDrunkChainAdded;         // true only when WE swapped the chain, so only we restore it



