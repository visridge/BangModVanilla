// BangModVanilla - ParryConfig.uci
// Included via BangModVanillaPlayerController.uci. Vars live in PC/Vars.uci; DefaultProperties in PC/Effects.uci (last).
simulated function SetAllParryBoxClassDefaults(bool bEnableBangModVanilla, bool bEnableSkeletal)
{
	class'BangModVanillaAOCDuelPlayerController'.default.bBangModVanillaParryBox = bEnableBangModVanilla;
	class'BangModVanillaAOCDuelPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModVanillaCDWDuelPlayerController'.default.bBangModVanillaParryBox = bEnableBangModVanilla;
	class'BangModVanillaCDWDuelPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModVanillaCTFPlayerController'.default.bBangModVanillaParryBox = bEnableBangModVanilla;
	class'BangModVanillaCTFPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModVanillaFFAPlayerController'.default.bBangModVanillaParryBox = bEnableBangModVanilla;
	class'BangModVanillaFFAPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModVanillaKOTHPlayerController'.default.bBangModVanillaParryBox = bEnableBangModVanilla;
	class'BangModVanillaKOTHPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModVanillaLTSPlayerController'.default.bBangModVanillaParryBox = bEnableBangModVanilla;
	class'BangModVanillaLTSPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModVanillaTDPlayerController'.default.bBangModVanillaParryBox = bEnableBangModVanilla;
	class'BangModVanillaTDPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModVanillaTOPlayerController'.default.bBangModVanillaParryBox = bEnableBangModVanilla;
	class'BangModVanillaTOPlayerController'.default.bSkeletalParry = bEnableSkeletal;
	class'BangModVanillaTUTPlayerController'.default.bBangModVanillaParryBox = bEnableBangModVanilla;
	class'BangModVanillaTUTPlayerController'.default.bSkeletalParry = bEnableSkeletal;
}

// Parry-box hits are traced on the ATTACKER's client, so every pawn on every client needs the server's box.
simulated function ApplyParryBoxSettingsToAllPawns()
{
	local AOCPawn P;
	local vector ParryBoxTranslation;

	foreach WorldInfo.AllPawns(class'AOCPawn', P)
	{
		if (P.ParryComponent == none || P.PawnFamily == none)
			continue;

		if (!class'BangModVanillaAOCDuelPlayerController'.default.bBangModVanillaParryBox)
		{
			P.ParryComponent.SetScale3D(vect(0.1, 0.17, 0.35));
			P.ParryComponent.SetTranslation(vect(30, 0, -30));
		}
		else if (class'BangModVanillaAOCDuelPlayerController'.default.bSkeletalParry)
		{
			P.ParryComponent.SetScale3D(vect(0.32, 0.32, 0.45));
			P.ParryComponent.SetTranslation(vect(0, 0, -45));
		}
		else
		{
			ParryBoxTranslation = P.PawnFamily.ParryBoxTranslation;
			if (AOCWeaponAttachment(P.CurrentWeaponAttachment) != none)
				ParryBoxTranslation += AOCWeaponAttachment(P.CurrentWeaponAttachment).ParryBoxTranslation;
			P.ParryComponent.SetScale3D(P.PawnFamily.ParryBoxScale);
			P.ParryComponent.SetTranslation(ParryBoxTranslation);
		}
		P.ParryComponent.SetTraceBlocking(false, false);
	}
}

// Server: push the parry box settings to every player, not just the admin who changed them.
function BangModVanillaSyncParryBoxToAll()
{
	local `{GAMEMODE}PlayerController PC;

	foreach WorldInfo.AllControllers(class'`{GAMEMODE}PlayerController', PC)
		PC.ClientSyncParryBoxSettings(class'BangModVanillaAOCDuelPlayerController'.default.bBangModVanillaParryBox,
			class'BangModVanillaAOCDuelPlayerController'.default.bSkeletalParry);
}

// Admin-only visual: shows every pawn's parry box on this client for tuning.
exec function BangModVanillaShowParryBoxes(optional bool bShow = true)
{
	local AOCPawn P;

	if (!PlayerReplicationInfo.bAdmin && WorldInfo.NetMode != NM_Standalone)
	{
		ClientDisplayConsoleMessage("You are not logged in as an administrator on this server.");
		return;
	}

	foreach WorldInfo.AllPawns(class'AOCPawn', P)
	{
		if (P.ParryComponent == none)
			continue;
		if (bShow)
			P.ParryComponent.SetMaterial(0, Material'CHV_Material_Pack.Materials.Masters.M_Water_Master');
		else
			P.ParryComponent.SetMaterial(0, Material'CHV_stoneshill_lightfx.Materials.Wall.Invisible');
		P.ParryComponent.SetHidden(!bShow);
	}
}

reliable client function ClientSyncParryBoxSettings(bool bEnableBangModVanilla, bool bEnableSkeletal)
{
	bBangModVanillaParryBox = bEnableBangModVanilla;
	bSkeletalParry = bEnableSkeletal;
	SetAllParryBoxClassDefaults(bEnableBangModVanilla, bEnableSkeletal);
	ApplyParryBoxSettingsToAllPawns();
}

simulated function SetAllCollisionRadiusClassDefaults(float Radius)
{
	class'BangModVanillaAOCDuelPlayerController'.default.fBangModVanillaCollisionRadius = Radius;
	class'BangModVanillaCDWDuelPlayerController'.default.fBangModVanillaCollisionRadius = Radius;
	class'BangModVanillaCTFPlayerController'.default.fBangModVanillaCollisionRadius = Radius;
	class'BangModVanillaFFAPlayerController'.default.fBangModVanillaCollisionRadius = Radius;
	class'BangModVanillaKOTHPlayerController'.default.fBangModVanillaCollisionRadius = Radius;
	class'BangModVanillaLTSPlayerController'.default.fBangModVanillaCollisionRadius = Radius;
	class'BangModVanillaTDPlayerController'.default.fBangModVanillaCollisionRadius = Radius;
	class'BangModVanillaTOPlayerController'.default.fBangModVanillaCollisionRadius = Radius;
	class'BangModVanillaTUTPlayerController'.default.fBangModVanillaCollisionRadius = Radius;
}

simulated function ApplyCollisionRadiusToCurrentPawn()
{
	local BangModVanillaAOCDuelPawn BMP;

	BMP = BangModVanillaAOCDuelPawn(Pawn);
	if (BMP == none || BMP.OuterCylinderComp == none)
		return;

	BMP.OuterCylinderComp.SetCylinderSize(class'BangModVanillaAOCDuelPlayerController'.default.fBangModVanillaCollisionRadius, 65.0);
}

reliable client function ClientSyncCollisionRadius(float Radius)
{
	fBangModVanillaCollisionRadius = Radius;
	SetAllCollisionRadiusClassDefaults(Radius);
	ApplyCollisionRadiusToCurrentPawn();
}

