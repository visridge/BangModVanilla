// BangModVanilla - Vars.uci
// Included via BangModVanillaGame.uci. Vars live in Game/Vars.uci; DefaultProperties in Game/Server.uci (last).
//SetGameType returns which game mode should be used for which map prefix
//You can do whatever you want with this. You can even use Options
// (options => the ?blah=blah things added after the map name when launching a server or in the map list)
//to add even more variety. See the ParseOption function in Src\Engine\Classes\GameInfo.uc
var config array<GameTypePrefix> SDKPrefixes;

// Local stats bridge. These values are per game-mode class in DefaultBangModVanilla.ini.
// Keep it disabled until the Chivalry dedicated server and local backend run on
// the same machine, then configure a non-empty API key before enabling it.
//
// Disabled 2026-09-14: superseded by the RCON round-start/end event stream. The HTTP
// JSON snapshot upload is no longer needed; kept as comments so the wiring is visible
// if a JSON endpoint is ever wanted again.
//var config bool bEnableStatsReporting;
//var config string StatsEndpoint;
//var config string StatsApiKey;
//var config string StatsServerId;
//var config float StatsReportInterval;

// BangModVanilla: watchdog on the tournament ready gate. Vanilla never gives up, so a gate that
// can never be satisfied leaves the server in a permanent pre-round. Turns a brick into
// a delay.
var config float fBangModVanillaTournamentHoldLimit;   // seconds before giving up; 0 disables
var float fBangModVanillaTournamentHoldSince;          // when the gate first blocked; 0 = not blocking

//var string StatsMatchId;
//var bool bStatsRequestInFlight;
//var HttpRequestInterface StatsRequest;

// RCON round-boundary reporting (opcodes 65-68). BangModVanillaRoundNumber counts the real
// rounds played on this map (incremented at each StartRound, so warmup never bumps it).
var int BangModVanillaRoundNumber;
var bool bBangModVanillaRoundEnding;   // re-entrancy guard for AOCEndRound (LTS draw recursion)
var bool bBangModVanillaMatchEnded;    // set when EndGame emits, suppresses the AOCEndRound emit
var bool bBangModVanillaMatchEndEmitted; // stops a second EndGame call (time limit + admin) re-emitting 66

// RCON objective reporting (opcode 69), Team Objective only. The counts cover the round
// being played and are zeroed when round 1 starts. BangModVanillaObjSkipMark is the stage index
// plus one of a stage that a skip was fired on (0 = none), so its end is not reported as
// a completion.
var int BangModVanillaObjCompleted;
var int BangModVanillaObjSkipped;
var int BangModVanillaObjSkipMark;

// Ranked LTS / Elo tags (BangModVanillaRanked). Spawned on LTS and TO only; none elsewhere.
var BangModVanillaRanked Ranked;
var float LastRankedHelpTime;   // RealTimeSeconds of the last !rankedhelp; 0 = not yet
